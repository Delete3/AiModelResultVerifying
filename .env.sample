# Copy to .env and fill in. .env is gitignored; this sample is not, so never put a real
# secret in this file.
#
# The Cloudflare Access Service Token for https://ezai2.inteware.com.tw -- the Chiayi
# RTX 5090 box. The second one-click button in the crown panel needs it; without it that
# button reports "not configured" and everything else works as before.
#
# Where these come from: Zero Trust -> Access -> Service Auth. The token used here is
# `ezai2-chiayi`. The Client Secret is shown once at creation and is in Vaultwarden.
#
# These are read by docker compose and passed to the Vite process, which attaches them to
# requests it proxies to ezai2. They are never sent to a browser -- do not move them into
# any file under src/.
#
# Do not write the secret with a shell command that lands in ~/.bash_history. Either edit
# this file in an editor, or:
#   read -rsp 'client secret: ' S; echo; printf 'RTX5090_CF_CLIENT_ID=%s\nRTX5090_CF_CLIENT_SECRET=%s\n' '<client-id>.access' "$S" > .env; chmod 600 .env; unset S
#
# After changing this file the container must be recreated -- env vars are fixed at create
# time, so `restart` is not enough:
#   docker compose -f docker-compose.yml up -d

RTX5090_CF_CLIENT_ID=
RTX5090_CF_CLIENT_SECRET=
